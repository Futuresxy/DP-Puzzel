// Shared immutable format definitions; configurable windows remain parameters.
`ifndef DP_DEFS_VH
`define DP_DEFS_VH
`define DP_TYPE_W (4)
`define DP_SCALE_TYPE_W (2)
`define DP_C_TYPE_W (1)
`define DP_DT_TF32 4'd0
`define DP_DT_FP16 4'd1
`define DP_DT_BF16 4'd2
`define DP_DT_MX8_E4M3 4'd3
`define DP_DT_MX8_E5M2 4'd4
`define DP_DT_MX6_E3M2 4'd5
`define DP_DT_MX6_E2M3 4'd6
`define DP_DT_MXFP4 4'd7
`define DP_DT_NVFP4 4'd8
`define DP_DT_HIF4 4'd9
`define DP_DT_INT8 4'd10
`define DP_SC_NONE 2'd0
`define DP_SC_E8M0 2'd1
`define DP_SC_E4M3 2'd2
`define DP_SC_E6M2 2'd3
`define DP_FP32_W (32)
`define DP_FP32_E (8)
`define DP_FP32_F (23)
`define DP_FP32_M (`DP_FP32_F+1)
`define DP_FP32_BIAS (127)
`define DP_FP32_MIN_E (1-`DP_FP32_BIAS)
`define DP_FP32_MAX_E (`DP_FP32_BIAS)
`define DP_FP32_MIN_LSB (`DP_FP32_MIN_E-`DP_FP32_F)
`define DP_HALF_W (16)
`define DP_LANE_W (32)
`define DP_GROUP_H (4)
`define DP_LANES (2)
`define DP_Q_LANES (4)
`define DP_E_LANES (8)
`define DP_MUL_BANKS (2)
`define DP_MUL_HI (8)
`define DP_MUL_LO (4)
`define DP_MANT_W (11)
`define DP_EXP_W (8)
`define DP_PRODUCT_W (2*`DP_MANT_W)
`define DP_PRODUCT_EXP_W (`DP_EXP_W+1)
`define DP_SCALE_W (8)
`define DP_SCALE_F (3)
`define DP_SCALE_M (`DP_SCALE_F+1)
`define DP_SCALE_BIAS (127)
`define DP_HIF_SCALE_BIAS (48)
`define DP_E_PAIR_W (10)
`define DP_E_GUARD (2)
`define DP_INT_PRODUCT_W (16)
`define DP_SCALE_SOP_W (`DP_E_PAIR_W+`DP_E_GUARD+$clog2(`DP_Q_LANES)+$clog2(`DP_LANES))
`define DP_BASE_LATENCY (8)
`define DP_DEFAULT_LOCAL_W (27)
`define DP_DEFAULT_GLOBAL_W (40)
`define DP_MAX_RAW_ANCHOR (2*(`DP_Q_MAX_E-`DP_Q_BIAS)+2*(`DP_SCALE_MAX_E-`DP_SCALE_BIAS)+`DP_Q_GROUP_HEADROOM)
`define DP_MIN_RAW_ANCHOR (2*(1-`DP_Q_BIAS)-2*`DP_SCALE_BIAS+`DP_Q_GROUP_HEADROOM)
`define DP_FP32_QNAN (32'h7fc00000)
`define DP_FP32_INF (32'h7f800000)
`define DP_CLASS_ZERO 2'd0
`define DP_CLASS_FINITE 2'd1
`define DP_CLASS_INF 2'd2
`define DP_CLASS_NAN 2'd3
`define DP_SPECIAL_W (4)
`define DP_NUM_W (1+`DP_MANT_W+`DP_EXP_W+2+1)
`define DP_NUM_SIGNAL (0)
`define DP_NUM_CLASS_LO (1)
`define DP_NUM_CLASS_W (2)
`define DP_NUM_EXP_LO (`DP_NUM_CLASS_LO+`DP_NUM_CLASS_W)
`define DP_NUM_MAG_LO (`DP_NUM_EXP_LO+`DP_EXP_W)
`define DP_NUM_SIGN (`DP_NUM_W-1)
`define DP_SP_NAN (3)
`define DP_SP_INVALID (2)
`define DP_SP_POS_INF (1)
`define DP_SP_NEG_INF (0)
`define DP_CT_FP32 1'b0
`define DP_CT_INT32 1'b1

// Fixed format fields and sharing grains; these define the v1.4 encoding.
`define DP_DEFAULT_K (16)
`define DP_FP16_E (5)
`define DP_FP16_F (10)
`define DP_FP16_BIAS ((1<<(`DP_FP16_E-1))-1)
`define DP_BF16_E (8)
`define DP_BF16_F (7)
`define DP_BF16_BIAS ((1<<(`DP_BF16_E-1))-1)
`define DP_TF32_PAD (`DP_FP32_W-1-`DP_FP32_E-`DP_FP16_F)
`define DP_QUARTER_W (`DP_HALF_W/2)
`define DP_EIGHTH_W (`DP_HALF_W/4)
`define DP_MX8_E4_E (4)
`define DP_MX8_E4_F (3)
`define DP_MX8_E4_BIAS ((1<<(`DP_MX8_E4_E-1))-1)
`define DP_MX8_E5_E (5)
`define DP_MX8_E5_F (2)
`define DP_MX8_E5_BIAS ((1<<(`DP_MX8_E5_E-1))-1)
`define DP_MX6_E3_E (3)
`define DP_MX6_E3_F (2)
`define DP_MX6_E3_BIAS ((1<<(`DP_MX6_E3_E-1))-1)
`define DP_MX6_E2_E (2)
`define DP_MX6_E2_F (3)
`define DP_MX6_E2_BIAS ((1<<(`DP_MX6_E2_E-1))-1)
`define DP_MX6_W (1+`DP_MX6_E3_E+`DP_MX6_E3_F)
`define DP_MX6_PAD (`DP_QUARTER_W-`DP_MX6_W)
`define DP_Q_EXP_W (5)
`define DP_Q_BIAS ((1<<(`DP_Q_EXP_W-1))-1)
`define DP_Q_MAX_E ((1<<`DP_Q_EXP_W)-2)
`define DP_E_ELEMENT_F (1)
`define DP_HIF_ELEMENT_F (2)
`define DP_E1_GRAIN (4)
`define DP_E2_GRAIN (8)
`define DP_SCALE_MAX_E ((1<<`DP_SCALE_W)-2)
`define DP_Q_GROUP_HEADROOM (2+$clog2(`DP_Q_LANES)+$clog2(`DP_LANES)-1)
`endif
