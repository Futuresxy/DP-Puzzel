  "findings": [
    {
      "id": "baseline_split",
      "files": [
        "configs/GA100.json",
        "hardware_model/compute_module.py"
      ],
      "finding": "JSON has 128 running cores/48 MiB global buffer; built-in A100 has 108/40 MiB. Physical and enabled resources must be distinct."
    },
    {
      "id": "vector_cost_coupling",
      "files": [
        "design_space_exploration/dse.py",
        "cost_model/cost_model.py"
      ],
      "finding": "Throughput vector_width/flop_per_cycle and ALU area counts are separate fields; changes need consistent resource bundles."
    },
    {
      "id": "tensor_cycle_scaling",
      "files": [
        "software_model/matmul.py"
      ],
      "finding": "Cycle backend uses utilization shortcuts or SCALE-Sim lookup, then divides total scalar cycles by mac_per_clock; native-K DP integration requires a distinct latency-aware hook."
    },
    {
      "id": "packing",
      "files": [
        "software_model/utils.py",
        "design_space_exploration/dse.py"
      ],
      "finding": "Only int8/fp16/fp32 in default types; integer bitwidth//8 template conversion cannot represent FP4 plus block scales. Operand/storage/output layouts must be separate."
    },
    {
      "id": "memory",
      "files": [
        "software_model/matmul.py",
        "hardware_model/compute_module.py"
      ],
      "finding": "HBM and chip-global L2 transfers, tile reuse and double buffering exist; SM SRAM has capacity but no separate measured collector/RF bandwidth."
    },
    {
      "id": "power",
      "files": [
        "hardware_model/compute_module.py",
        "cost_model/cost_model.py",
        "design_space_exploration/dse.py"
      ],
      "finding": "Reviewed modules do not supply a whole-chip runtime power estimator; DP evidence is only one component."
    },
    {
      "id": "search_porting",
      "files": [
        "design_space_exploration/dse.py"
      ],
      "finding": "Use enumeration/filter/mapper strategy, not the script unchanged: cost imports are commented, active core updates are separate from physical area count, best_arch_specs aliases the mutable current config, and layer-count normalization differs between filters."
    },
    {
      "id": "workload",
      "files": [
        "software_model/transformer.py",
        "software_model/communication_primitives.py"
      ],
      "finding": "Dense TP transformer and all-reduce are available; DeepSeek MoE/compressed attention/quantization and all-to-all require adapters."
    }
  ],
