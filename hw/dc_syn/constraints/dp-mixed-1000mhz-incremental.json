{
  "schema_version": 1,
  "constraint_id": "dp-mixed-l8-1000mhz-incremental",
  "purpose": "L8 1GHz gated timing-driven compile plus up to two incremental passes; expose DFF wrappers for mapping/hold buffering, retain arithmetic module hierarchy",
  "clock_port": "clock",
  "period_ns": 1.0,
  "clock_latency_ns": 0.1,
  "setup_uncertainty_ns": 0.1,
  "hold_uncertainty_ns": 0.03,
  "clock_transition_ns": 0.1,
  "input_delay_max_ns": 0.2,
  "input_delay_min_ns": 0.0,
  "output_delay_max_ns": 0.2,
  "output_delay_min_ns": 0.0,
  "input_transition_ns": 0.1,
  "output_load_pf": 0.01,
  "timing_max_paths": 50,
  "clock_gating": true,
  "clock_gating_min_bitwidth": 4,
  "optimize_area": false,
  "hold_fix": true,
  "hierarchy": {
    "keep_modules": [],
    "expand_modules": [
      "dp_lib_DFF*",
      "dp_dff_*"
    ],
    "expand_instances": [],
    "expand_depth": 0
  },
  "write_sdf": false,
  "timing_incremental_passes": 2
}
