  localparam integer SF_COUNT=WORD_COUNT/4;
  localparam integer G1_COUNT=WORD_COUNT/2;
  localparam integer LATENCY=18;
  reg clock = 0;
  always #5 clock = ~clock;
  reg reset = 1;
  reg cfg_valid = 0;
  wire cfg_ready;
  reg [3:0] a_dtype, b_dtype;
  reg [1:0] a_sf_type, b_sf_type, c_type;
  reg [2:0] rm, out_type;
  reg ab_valid = 0, c_valid = 0, input_last = 0;
  wire ab_ready, c_ready, result_valid, result_last, idle;
  reg [15:0] a_words [0:WORD_COUNT-1], b_words [0:WORD_COUNT-1];
  reg [7:0] a_scales [0:SF_COUNT-1], b_scales [0:SF_COUNT-1];
  reg a_group0 [0:WORD_COUNT-1], b_group0 [0:WORD_COUNT-1];
  reg a_group1 [0:G1_COUNT-1], b_group1 [0:G1_COUNT-1];
  reg [31:0] c_word = 0;
  wire [31:0] result;
